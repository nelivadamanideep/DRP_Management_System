# Environment overrides for docker compose.
# Copy to `.env` and adjust for your environment.

# ---- Database -------------------------------------------------------------
MYSQL_DATABASE=erpms
MYSQL_USER=erpms
MYSQL_PASSWORD=erpms_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# ---- Security -------------------------------------------------------------
ERPMS_JWT_SECRET=please-change-this-in-production-to-a-long-random-string
ERPMS_ADMIN_EMAIL=admin@example.com
ERPMS_ADMIN_PASSWORD=Admin12345
ERPMS_ALLOWED_ORIGINS=http://localhost

# ---- AI (Claude Sonnet 4.5 via Anthropic Messages API) --------------------
# Obtain an API key from https://console.anthropic.com/ and paste below.
# Leave empty to disable AI endpoints (they will return a friendly notice).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ---- Email (JavaMail / SMTP) ---------------------------------------------
# Provide any SMTP provider (SendGrid, Mailtrap, Gmail app-password, etc.)
# and set ERPMS_MAIL_ENABLED=true to actually deliver notification / OTP emails.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
ERPMS_MAIL_ENABLED=false
ERPMS_MAIL_FROM=no-reply@erpms.local
